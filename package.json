{
  "name": "wildstat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "spacetime:generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path spacetimedb",
    "spacetime:build": "spacetime build --module-path spacetimedb",
    "spacetime:publish:local": "spacetime publish wildwood-coop --module-path spacetimedb --server local",
    "spacetime:publish:cloud": "spacetime publish wildwood-coop --module-path spacetimedb --server maincloud",
    "build:coop": "vite build --config config/vite.coop.config.ts",
    "build:game": "vite build --config config/vite.game.config.ts",
    "build:balance": "vite build --config config/vite.balance.config.ts",
    "build:stat-graph": "vite build --config config/vite.stat-graph.config.ts",
    "build:client": "npm run build:coop && npm run build:game && node scripts/fingerprint-client.mjs && node scripts/check-client-build.mjs",
    "balance:lab": "vite --config config/vite.balance.config.ts --host 127.0.0.1 --open /balance-lab.html",
    "balance:stat-graph": "vite --config config/vite.stat-graph.config.ts --host 127.0.0.1 --open /balance-stat-graph.html",
    "balance:simulate": "tsx scripts/balance-report.ts",
    "map:editor": "node scripts/map-editor-server.mjs",
    "test:unit": "vitest run --exclude src/balance/simulator.test.ts",
    "test:unit:watch": "vitest --exclude src/balance/simulator.test.ts",
    "test:balance": "vitest run src/balance/simulator.test.ts",
    "loadtest:virtual": "tsx scripts/virtual-player-load-test.ts",
    "release": "node scripts/release.mjs",
    "release:live": "node scripts/release-live.mjs",
    "check:release": "node scripts/release.mjs --check",
    "typecheck:coop": "tsc --noEmit -p config/tsconfig.coop.json",
    "typecheck:balance": "tsc --noEmit -p config/tsconfig.balance.json",
    "typecheck:loadtest": "tsc --noEmit -p config/tsconfig.loadtest.json",
    "serve:dist": "python3 -m http.server --directory dist 8000",
    "art:align": "python3 -m http.server --directory . 4173",
    "art:unity": "node scripts/unity-sprite-exporter.mjs",
    "art:unity:prepare": "node scripts/unity-sprite-exporter.mjs --prepare-only",
    "art:unity:check": "node scripts/unity-sprite-exporter.mjs --check",
    "art:enemy-align": "python3 -m http.server --directory . 4173",
    "balance:audit": "tsx scripts/balance-experience-report.ts",
    "profile:crowds-motion": "tsx scripts/profiling/crowds-and-motion.ts",
    "sharding:build": "spacetime build --module-path spacetimedb-map",
    "sharding:configure": "tsx scripts/sharding/configure.ts",
    "sharding:smoke": "tsx scripts/sharding/smoke-local.ts"
  },
  "dependencies": {
    "spacetimedb": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "linkedom": "0.18.12",
    "postcss": "^8.5.25",
    "tsx": "^4.23.12",
    "typescript": "~5.6.2",
    "undici": "^6.28.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.10"
  }
}
