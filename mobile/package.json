{
  "name": "wildstat-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "node ../node_modules/typescript/bin/tsc -p tsconfig.json",
    "test": "node ../node_modules/vitest/vitest.mjs run src/test-commerce.test.ts src/ota-controller.test.ts src/ota-signature.test.ts src/closed-beta-invite.test.ts",
    "build": "node scripts/build.mjs",
    "sync": "npm run build && cap sync",
    "ios": "npm run sync && cap open ios",
    "android": "npm run sync && cap open android",
    "ota": "node scripts/ota/cli.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "8.1.0",
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor/android": "8.5.1",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.5.1",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.1",
    "@capacitor/local-notifications": "8.3.1",
    "@capawesome/capacitor-live-update": "8.4.2",
    "@revenuecat/purchases-capacitor": "13.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1"
  }
}
