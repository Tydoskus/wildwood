# Local art library and work-in-progress sources #
##################################################
# Vendor packs are licensed for the game, not for redistribution in a public
# repository, so they stay local. Generated candidates and inbox art remain
# local until deliberately promoted.
art-source/vendor/**
art-source/generated/**
art-source/inbox/**
art-source/map-editor-backups/**
art-source/retired/**
art-source/unity-workspace/**
*.unitypackage

# Local profiling exports and machine-specific test captures #
#############################################################
local-data/**
