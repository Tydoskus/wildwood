######################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Local art library and work-in-progress sources #
##################################################
# Existing tracked source art stays tracked. New vendor packs, generated
# candidates, and inbox art remain local until deliberately promoted.
art-source/vendor/**
art-source/generated/**
art-source/inbox/**
art-source/map-editor-backups/**
art-source/retired/**
art-source/unity-workspace/**
*.unitypackage

# Local profiling exports and machine-specific test captures #
#############################################################
local-data/**

# Local sharding inspection bindings
scripts/sharding/bindings/
