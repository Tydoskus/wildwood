# Configure these through the hosting provider's secret manager.
# Do not put these values in mobile/commerce.local.json or frontend builds.
REVENUECAT_WEBHOOK_AUTHORIZATION=REPLACE_WITH_RANDOM_AUTHORIZATION_HEADER
REVENUECAT_WEBHOOK_SIGNING_SECRET=REPLACE_WITH_REVENUECAT_HMAC_SIGNING_SECRET
SPACETIME_VERIFIER_TOKEN=REPLACE_WITH_DEDICATED_VERIFIER_IDENTITY_TOKEN
SPACETIME_DATABASE_URL=https://maincloud.spacetimedb.com/v1/database/wildwood-coop
# RevenueCat *production app configuration IDs*, not bundle IDs or Test Store.
REVENUECAT_STORE_APPS={"appREPLACEAPPLE":"APP_STORE","appREPLACEGOOGLE":"PLAY_STORE"}
HOST=127.0.0.1
PORT=8787
